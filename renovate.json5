{
  extends: [
    'config:recommended',
  ],
  timezone: 'Asia/Tokyo',
  minimumReleaseAge: '7 days',
  patch: {
    automerge: true,
  },
  packageRules: [
    {
      matchManagers: [
        'npm',
      ],
      rangeStrategy: 'pin',
    },
    {
      matchDepNames: [
        'rolldown',
      ],
      postUpgradeTasks: {
        commands: [
          'pnpm install --frozen-lockfile',
          'pnpm run package',
        ],
        installTools: {
          node: {},
          pnpm: {},
        },
        fileFilters: ['dist/**'],
        executionMode: 'branch',
      },
    },
    {
      enabled: false,
      matchPackageNames: [
        '/@actions/cache/',
      ],
    },
    {
      groupName: 'Android Gradle Plugin',
      matchPackageNames: [
        'com.android.library{/,}**',
        'com.android.application{/,}**',
      ],
    },
    {
      groupName: 'Oxc',
      groupSlug: 'oxc',
      groupSingleUpdates: true,
      matchDepNames: [
        'oxfmt',
        'oxlint',
        'oxlint-tsgolint',
      ],
    },
    {
      groupName: 'Node.js',
      matchDatasources: [
        'node-version',
      ],
      matchDepNames: [
        'node',
      ],
      ignoreUnstable: true,
      rangeStrategy: 'pin',
      versioning: 'node',
    },
  ],
}
