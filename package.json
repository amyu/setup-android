{
  "name": "setup-android",
  "version": "6",
  "description": "Install and cache Android SDK components on self-hosted GitHub Actions runners",
  "keywords": [
    "actions",
    "android",
    "hosted",
    "runner",
    "self",
    "setup",
    "setup-android"
  ],
  "license": "MIT",
  "author": "amyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amyu/setup-android.git"
  },
  "type": "module",
  "main": "dist/setup/index.js",
  "scripts": {
    "check": "oxlint . && oxfmt --check . && tsc",
    "package": "pnpm dlx rimraf dist && rolldown -c"
  },
  "dependencies": {
    "@actions/cache": "6.3.0",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "rolldown": "1.3.3",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  }
}
