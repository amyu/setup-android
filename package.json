{
  "name": "setup-android",
  "version": "6",
  "description": "Install and cache Android SDK components on self-hosted GitHub Actions runners",
  "type": "module",
  "main": "dist/setup/index.js",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "check": "oxlint src && oxfmt --check src && tsc --noEmit",
    "package": "pnpm dlx rimraf dist && rolldown -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amyu/setup-android.git"
  },
  "keywords": [
    "setup-android",
    "actions",
    "android",
    "setup",
    "self",
    "hosted",
    "runner"
  ],
  "author": "amyu",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "6.3.0",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "rolldown": "1.3.2",
    "typescript": "7.0.2"
  }
}
