{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "7 days",
  "patch": {
    "automerge": true,
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["action.yml"],
      "matchStrings": ["runs.{ \"currentValue\": using }"],
      "depNameTemplate": "GitHub Actions Node.js runtime",
      "datasourceTemplate": "custom.github-actions-node",
      "versioningTemplate": "regex:^node(?<major>\\d+)$",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["action.yml", "README.md"],
      "matchStrings": [
        "  command-line-tools-version:\\r?\\n(?:    [^\\n]*\\n)*?    default: \"(?<currentValue>\\d+)\"",
        "# default: (?<currentValue>\\d+)\\r?\\n(?:[ \\t]*#[^\\n]*\\n)*[ \\t]*command-line-tools-version:",
        "command-line-tools-version: (?<currentValue>\\d+)",
      ],
      "depNameTemplate": "Android SDK Command-line Tools",
      "datasourceTemplate": "custom.android-command-line-tools",
      "extractVersionTemplate": "/commandlinetools-linux-(?<version>\\d+)_latest\\.zip$",
      // Build numbers can jump by millions between releases.
      "versioningTemplate": "regex:^(?<minor>\\d+)$",
    },
  ],
  "customDatasources": {
    "android-command-line-tools": {
      "defaultRegistryUrlTemplate": "https://developer.android.com/studio",
      "format": "html",
    },
    // Only offer runtimes documented by GitHub, rather than every Node.js release.
    "github-actions-node": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/github/docs/main/content/actions/reference/workflows-and-actions/metadata-syntax.md",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": [releases.version.$match(/^[-*] Use `(node[0-9]+)` for Node\\.js/).{ \"version\": groups[0] }], \"homepage\": \"https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#runsusing-for-javascript-actions\" }",
      ],
    },
  },
  "packageRules": [
    {
      "matchDatasources": ["custom.android-command-line-tools"],
      // The download links include the build number but have no release timestamp.
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "postUpgradeTasks": {
        "commands": [
          "node scripts/update-command-line-tools-checksums.mjs",
          "pnpm install --frozen-lockfile",
          "pnpm run check",
          "pnpm run package",
        ],
        "installTools": { "node": {}, "pnpm": {} },
        "fileFilters": ["src/command-line-tools-checksums.json", "dist/**"],
        "executionMode": "branch",
      },
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "pin",
    },
    {
      "enabled": true,
      "matchPackageNames": [
        "@actions/cache",
        "@actions/core",
        "@actions/tool-cache",
        "@actions/exec",
        "minimatch",
        "rolldown",
      ],
      "postUpgradeTasks": {
        "commands": ["pnpm install --frozen-lockfile", "pnpm run check", "pnpm run package"],
        "installTools": {
          "node": {},
          "pnpm": {},
        },
        "fileFilters": ["dist/**"],
        "executionMode": "branch",
      },
    },
    {
      "groupName": "Android Gradle Plugin",
      "matchPackageNames": ["com.android.library{/,}**", "com.android.application{/,}**"],
    },
    {
      "groupName": "Oxc",
      "groupSlug": "oxc",
      "groupSingleUpdates": true,
      "matchDepNames": ["oxfmt", "oxlint", "oxlint-tsgolint"],
    },
    {
      "groupName": "Node.js",
      "matchDepNames": ["node", "@types/node", "GitHub Actions Node.js runtime"],
    },
    {
      "matchDatasources": ["node-version"],
      "matchDepNames": ["node"],
      "ignoreUnstable": true,
      "rangeStrategy": "pin",
      "versioning": "node",
    },
    {
      "matchFileNames": ["sample-android-project/**"],
      "automerge": true,
      "minimumReleaseAge": "0 days",
      "platformAutomerge": false,
    },
  ],
}
